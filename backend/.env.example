DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wc2026
PORT=8000
# Comma-separated CORS origins; defaults to the local Vite dev server.
# Set this to the deployed frontend origin(s) in production.
ALLOWED_ORIGINS=http://localhost:5173

# Automated results sync from football-data.org. Off by default; set
# RESULTS_SYNC_ENABLED=true and a token to poll for finished matches.
# Free token: https://www.football-data.org/client/register
FOOTBALL_DATA_API_TOKEN=
FOOTBALL_DATA_COMPETITION=WC
RESULTS_SYNC_ENABLED=false
RESULTS_SYNC_INTERVAL_SECONDS=600
